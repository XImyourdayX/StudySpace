<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StudySpace.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vistas="clr-namespace:StudySpace.Vistas"
    FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource TarjetaOscuro}}"
    Shell.TabBarForegroundColor="{StaticResource Azul}"
    Shell.TabBarTitleColor="{StaticResource Azul}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}">

    <!-- PANTALLA DE BIENVENIDA -->
    <ShellContent
        Route="bienvenida"
        ContentTemplate="{DataTemplate vistas:PaginaBienvenida}" />

    <!-- NAVEGACIÓN PRINCIPAL -->
    <TabBar Route="principal">

        <!-- INICIO -->
        <ShellContent
            Title="Inicio"
            Route="inicio"
            ContentTemplate="{DataTemplate vistas:PaginaPrincipal}">

            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="IconosMaterial"
                    Glyph="&#xe88a;"
                    Size="24"
                    Color="#6B7194" />
            </ShellContent.Icon>
        </ShellContent>

        <!-- CURSOS -->
        <ShellContent
            Title="Cursos"
            Route="cursos"
            ContentTemplate="{DataTemplate vistas:PaginaCursos}">

            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="IconosMaterial"
                    Glyph="&#xea19;"
                    Size="24"
                    Color="#6B7194" />
            </ShellContent.Icon>
        </ShellContent>

        <!-- HU09 - CALENDARIO -->
        <ShellContent
            Title="Calendario"
            Route="calendario"
            ContentTemplate="{DataTemplate vistas:PaginaCalendario}">

            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="IconosMaterial"
                    Glyph="&#xebcc;"
                    Size="24"
                    Color="#6B7194" />
            </ShellContent.Icon>
        </ShellContent>

        <!-- PERFIL -->
        <ShellContent
            Title="Perfil"
            Route="perfil"
            ContentTemplate="{DataTemplate vistas:PaginaPerfil}">

            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="IconosMaterial"
                    Glyph="&#xe7fd;"
                    Size="24"
                    Color="#6B7194" />
            </ShellContent.Icon>
        </ShellContent>

    </TabBar>
</Shell>
