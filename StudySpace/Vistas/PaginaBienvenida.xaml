<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudySpace.Vistas.PaginaBienvenida"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F8F7FF, Dark=#101326}">
    <Grid>
        <Image Source="{AppThemeBinding Light=bienvenida_fondo_light.png, Dark=bienvenida_fondo_dark.png}"
               Aspect="Fill" InputTransparent="True" />
        <ScrollView VerticalScrollBarVisibility="Never">
            <Grid Padding="24,24,24,26" MaximumWidthRequest="420" HorizontalOptions="Center"
                  RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16" VerticalOptions="Fill">
                <VerticalStackLayout Spacing="6">
                    <Image Source="logo.png" HeightRequest="62" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Text="Study Space" FontFamily="OpenSansSemibold" FontSize="25" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}" />
                </VerticalStackLayout>
                <Image Grid.Row="1" Source="{AppThemeBinding Light=bienvenida_personaje_light.png, Dark=bienvenida_personaje_dark.png}"
                       Aspect="AspectFit" HeightRequest="268" MaximumWidthRequest="290" HorizontalOptions="Center" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Row="2" Spacing="10">
                    <Label FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="28" HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}">
                        <Label.FormattedText><FormattedString>
                            <Span Text="Organiza tu vida"/><Span Text="&#10;académica" TextColor="{AppThemeBinding Light=#7132C5, Dark=#BB90FF}"/>
                        </FormattedString></Label.FormattedText>
                    </Label>
                    <Label Text="Gestiona tus cursos, tareas y recordatorios en un solo lugar." FontSize="14" LineBreakMode="WordWrap"
                           HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#625C78, Dark=#C1BDD5}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="3" Spacing="8" Margin="0,8,0,0">
                    <Button Text="Comenzar  →" Clicked="OnComenzar" HeightRequest="54" CornerRadius="27"
                            FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="17" TextColor="White" BorderWidth="1" BorderColor="#B67AF9">
                        <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#AD58EF" Offset="0"/><GradientStop Color="#7830E4" Offset="0.48"/><GradientStop Color="#5427C9" Offset="1"/>
                        </LinearGradientBrush></Button.Background>
                    </Button>
                    <Button Text="Ya tengo una cuenta" Clicked="OnTengoCuenta" HeightRequest="44" BackgroundColor="Transparent"
                            FontFamily="OpenSansSemibold" FontSize="14" TextColor="{AppThemeBinding Light=#6530B7, Dark=#C6A0FF}" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
