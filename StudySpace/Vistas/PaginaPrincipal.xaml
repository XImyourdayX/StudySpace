<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudySpace.VistaModelos"
             xmlns:dto="clr-namespace:Aplicacion.DTOs;assembly=Aplicacion"
             x:Class="StudySpace.Vistas.PaginaPrincipal"
             x:DataType="vm:PrincipalVM"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="24,48,24,0"
          MaximumWidthRequest="420" HorizontalOptions="Fill">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                <Label Text="{Binding Saludo}" Style="{StaticResource Titulo}" />
                <Label Text="Esto es lo que tienes por hacer" Style="{StaticResource Subtitulo}" />
            </VerticalStackLayout>
            <Frame Grid.Column="1" WidthRequest="56" HeightRequest="56" CornerRadius="28" Padding="0"
                   HasShadow="True"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Violeta}, Dark={StaticResource PrimaryDark}}"
                   HorizontalOptions="End" VerticalOptions="Center">
                <Label FontFamily="IconosMaterial" Text="&#xe145;" FontSize="26"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NuevaTareaCommand}" />
                </Frame.GestureRecognizers>
            </Frame>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,0,0,20">
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" HeightRequest="88">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding Pendientes}" FontSize="30" FontAttributes="Bold"
                           TextColor="{StaticResource Azul}" HorizontalOptions="Center" />
                    <Label Text="Pendientes" Style="{StaticResource Subtitulo}" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" HeightRequest="88">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding Completadas}" FontSize="30" FontAttributes="Bold"
                           TextColor="{StaticResource Verde}" HorizontalOptions="Center" />
                    <Label Text="Completadas" Style="{StaticResource Subtitulo}" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}" HeightRequest="88">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding Vencidas}" FontSize="30" FontAttributes="Bold"
                           TextColor="{StaticResource Rojo}" HorizontalOptions="Center" />
                    <Label Text="Vencidas" Style="{StaticResource Subtitulo}" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Label Grid.Row="2" Text="Próximas tareas" Style="{StaticResource Etiqueta}"
               FontSize="17" Margin="0,0,0,10" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Tareas}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:TareaDTO">
                    <Border Style="{StaticResource Tarjeta}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark={StaticResource BordeOscuro}}"
                                    BackgroundColor="Transparent" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Label Text="&#xe92d;" FontFamily="IconosMaterial" FontSize="22"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}" />
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Completada}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Verde}" />
                                        <Setter Property="Stroke" Value="{StaticResource Verde}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCompletarTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Titulo}" Style="{StaticResource Etiqueta}"
                                       FontSize="15" LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Completada}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding CursoNombre}" TextColor="{Binding CursoColor}"
                                                  FontAttributes="Bold" />
                                            <Span Text="  ·  " />
                                            <Span Text="{Binding FechaTexto}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding EstaVencida}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Rojo}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>

                            <Border Grid.Column="2" StrokeThickness="0" Padding="8,3"
                                    VerticalOptions="Center" BackgroundColor="{Binding PrioridadColor}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Prioridad}" TextColor="White"
                                       FontSize="11" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="3" Text="Aún no tienes tareas. Toca + para crear la primera."
               Style="{StaticResource Subtitulo}" HorizontalTextAlignment="Center"
               VerticalOptions="Start" Margin="0,30,0,0"
               IsVisible="{Binding EstaVacio}" />
    </Grid>
</ContentPage>