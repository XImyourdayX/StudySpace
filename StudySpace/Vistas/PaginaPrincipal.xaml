<?xml version='1.0' encoding='UTF-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:StudySpace.VistaModelos" xmlns:dto="clr-namespace:Aplicacion.DTOs;assembly=Aplicacion" x:Class="StudySpace.Vistas.PaginaPrincipal" x:DataType="vm:PrincipalVM" BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}" Shell.NavBarIsVisible="False">

    <!-- INICIO V3: escritorio académico universal; solo cambia la presentación. -->
    <Grid RowDefinitions="*,Auto" RowSpacing="9" Padding="14,10,14,12" MaximumWidthRequest="520" HorizontalOptions="Fill">

        <CollectionView Grid.Row="0" ItemsSource="{Binding Tareas}" SelectionMode="None" VerticalScrollBarVisibility="Default">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout x:DataType="vm:PrincipalVM" Spacing="15" Padding="0,7,0,12">

                    <!-- Bienvenida inclusiva: escritorio sin personajes; saludo real, no incrustado en la imagen. -->
                    <Border IsVisible="{Binding MostrarResumen}" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark=#594089}" Padding="0" BackgroundColor="#302052">
                        <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                        <Grid HeightRequest="172" IsClippedToBounds="True">
                            <!-- La ilustración no lleva nombres de usuario ni cifras de ejemplo. -->
                            <Image Source="inicio_escritorio.png" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True"/>
                            <Grid ColumnDefinitions="55*,45*" Padding="16,12,8,12" ColumnSpacing="0" InputTransparent="True">
                                <VerticalStackLayout Grid.Column="0" Spacing="7" VerticalOptions="Center">
                                    <Label Text="TU ESPACIO ACADÉMICO" TextColor="#DBC3FF" FontSize="9" FontAttributes="Bold" CharacterSpacing="0.9" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Saludo}" TextColor="White" FontAttributes="Bold" FontSize="23" MaxLines="2" LineBreakMode="WordWrap"/>
                                    <Label Text="Organiza tus pendientes y avanza a tu ritmo." FontSize="11" TextColor="#F0E8FF" LineBreakMode="WordWrap" MaxLines="3"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Los tres indicadores contienen los valores reales del usuario. -->
                    <Grid IsVisible="{Binding MostrarResumen}" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Grid.Column="0" Padding="11,11,8,10" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark=#6B50AA}" BackgroundColor="{AppThemeBinding Light={StaticResource LavandaClaro}, Dark=#302852}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="19"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="" FontFamily="IconosMaterial" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark=#C5A3FF}"/>
                                <Label Text="{Binding Pendientes}" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark=#F0E8FF}"/>
                                <Label Text="Pendientes" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark=#D9C8FA}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Padding="11,11,8,10" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource ErrorBordeClaro}, Dark=#A95D83}" BackgroundColor="{AppThemeBinding Light={StaticResource ErrorFondoClaro}, Dark=#442940}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="19"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="" FontFamily="IconosMaterial" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource ErrorTextoClaro}, Dark=#FF9DBB}"/>
                                <Label Text="{Binding Vencidas}" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ErrorTextoClaro}, Dark=#FFE0E8}"/>
                                <Label Text="Vencidas" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource ErrorTextoClaro}, Dark=#F4BBD0}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Padding="11,11,8,10" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource ExitoBordeClaro}, Dark=#3C9579}" BackgroundColor="{AppThemeBinding Light={StaticResource ExitoFondoClaro}, Dark=#1C403D}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="19"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="" FontFamily="IconosMaterial" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource ExitoTextoClaro}, Dark=#81EAC2}"/>
                                <Label Text="{Binding CursosActivos}" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource ExitoTextoClaro}, Dark=#E3FFF1}"/>
                                <Label Text="Cursos" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource ExitoTextoClaro}, Dark=#B4EFD6}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Progreso real: porcentaje y barra siempre reflejan SQLite. -->
                    <Border IsVisible="{Binding MostrarResumen}" Padding="16,15" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark=#514679}" BackgroundColor="{AppThemeBinding Light={StaticResource TarjetaClaro}, Dark=#252341}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <Label Text="Tu progreso académico" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}"/>
                                    <Label Text="Según tus tareas completadas" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}"/>
                                </VerticalStackLayout>
                                <!-- Porcentaje real. La barra inferior representa visualmente el avance. -->
                                <Label Grid.Column="1" Text="{Binding PorcentajeProgreso, StringFormat='{0}%'}" FontSize="27" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark=#D2B5FF}"/>
                            </Grid>
                            <ProgressBar Progress="{Binding Progreso}" ProgressColor="{AppThemeBinding Light={StaticResource AccionClaro}, Dark=#A980F2}" BackgroundColor="{AppThemeBinding Light={StaticResource LavandaClaro}, Dark=#463C67}" HeightRequest="8"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                <Label Text="{Binding Completadas, StringFormat='Completaste {0} tarea(s)'}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}"/>
                                <Label Grid.Column="1" Text="{Binding Tareas.Count, StringFormat='{0} en total'}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}"/>
                            </Grid>
                            <Button Text="Ver mis reportes    ›" Command="{Binding VerReportesCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource LavandaClaro}, Dark=#4A386F}" TextColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark=#E9D9FF}" FontSize="13" FontAttributes="Bold" CornerRadius="15" HeightRequest="43"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Zona de tareas y estado vacío junto al título, sin huecos gigantes. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Padding="1,8,0,1">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{Binding TituloSeccion}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}"/>
                            <Label Text="Toca una tarea para ver sus detalles" IsVisible="{Binding MostrarResumen}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{Binding TextoVerTodas}" Command="{Binding AlternarVistaTareasCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark=#C4A3FF}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" Padding="5,8"/>
                    </Grid>
                    <Border IsVisible="{Binding EstaVacio}" Padding="18,19" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark=#363051}" BackgroundColor="{AppThemeBinding Light={StaticResource TarjetaClaro}, Dark=#211D3A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                            <Border WidthRequest="46" HeightRequest="46" BackgroundColor="{AppThemeBinding Light={StaticResource LavandaClaro}, Dark=#493577}" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="15"/></Border.StrokeShape>
                                <Label Text="" FontFamily="IconosMaterial" FontSize="25" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark=#D2B4FF}"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="¡Todo al día!" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}"/>
                                <Label Text="No tienes tareas registradas. Cuando crees una, aparecerá aquí." FontSize="11" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Tarjetas y gestos conservados: icono completa; resto abre detalle. -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:TareaDTO">
                    <Border Padding="0" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark=#393456}" BackgroundColor="{AppThemeBinding Light={StaticResource TarjetaClaro}, Dark=#24243F}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="19"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="5,43,*" MinimumHeightRequest="91">
                            <BoxView Grid.Column="0" Color="{Binding PrioridadColor}"/>
                            <Label Grid.Column="1" Text="" FontFamily="IconosMaterial" FontSize="24" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark=#BB9AFF}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Completada}" Value="True">
                                        <Setter Property="Text" Value=""/>
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ExitoTextoClaro}, Dark={StaticResource Verde}}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCompletarTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="1,11,11,10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTareaTapped"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="5">
                                    <Label Text="{Binding Titulo}" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2" TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Completada}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding CursoNombre}" FontSize="11" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}"/>
                                    <Label Text="{Binding FechaTexto}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding EstaVencida}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorTextoClaro}, Dark={StaticResource Rojo}}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Padding="8,5" VerticalOptions="Start" StrokeThickness="0" BackgroundColor="{Binding PrioridadColor}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="11"/></Border.StrokeShape>
                                    <Label Text="{Binding Prioridad}" FontSize="10" FontAttributes="Bold" TextColor="#111427">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Prioridad}" Value="Media">
                                                <Setter Property="TextColor" Value="#322109"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Prioridad}" Value="Baja">
                                                <Setter Property="TextColor" Value="#082C1E"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <!-- El mensaje sin tareas aparece en el encabezado, no al pie de la página. -->
                <ContentView HeightRequest="1"/>
            </CollectionView.EmptyView>
        </CollectionView>

        <Button Grid.Row="1" Text="+  Nueva tarea" Style="{StaticResource BotonPrincipal}" BackgroundColor="{AppThemeBinding Light={StaticResource AccionClaro}, Dark=#6746EB}" TextColor="White" FontAttributes="Bold" FontSize="15" Command="{Binding NuevaTareaCommand}" CornerRadius="19" HeightRequest="55"/>
    </Grid>
</ContentPage>