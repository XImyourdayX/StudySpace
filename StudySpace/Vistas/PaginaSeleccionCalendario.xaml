<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:servicios="clr-namespace:StudySpace.Servicios"
    x:Class="StudySpace.Vistas.PaginaSeleccionCalendario"
    BackgroundColor="{AppThemeBinding Light=#F8F8FD, Dark=#13131F}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="14"
          Padding="20,24,20,20"
          MaximumWidthRequest="560"
          HorizontalOptions="Fill">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <VerticalStackLayout Spacing="5">
                <Label Text="Elegir calendario"
                       FontAttributes="Bold"
                       FontSize="24"
                       TextColor="{AppThemeBinding Light=#17172C, Dark=White}" />
                <Label Text="¿Dónde quieres guardar esta entrega?"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#55576F, Dark=#B9B9D0}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Cerrar"
                    Clicked="OnCancelarClicked"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#5B4BE7, Dark=#BEB4FF}"
                    FontSize="13" />
        </Grid>

        <Border Grid.Row="1"
                Padding="12"
                BackgroundColor="{AppThemeBinding Light=#ECEAFF, Dark=#282441}"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Label x:Name="TextoAyuda" Text="Elige el calendario donde quieras ver las entregas. Si tu cuenta Google está sincronizada, los eventos también podrán aparecer en otros dispositivos."
                   FontSize="12"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light=#4E478A, Dark=#DBD3FF}" />
        </Border>

        <CollectionView x:Name="ListaCalendarios"
                        Grid.Row="2"
                        ItemsSource="{Binding Calendarios}"
                        SelectionMode="Single"
                        SelectionChanged="OnSeleccionCambio"
                        VerticalOptions="FillAndExpand">
            <CollectionView.EmptyView>
                <Label Text="No hay calendarios editables en el teléfono."
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="servicios:OpcionCalendarioAndroid">
                    <Border Stroke="{AppThemeBinding Light=#DEDEEF, Dark=#45415B}"
                            StrokeThickness="1"
                            Padding="14,13"
                            Margin="0,5"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#242337}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="#806CF5" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Border WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Start"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light=#F0ECFF, Dark=#3E355F}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="&#xe878;"
                                       FontFamily="IconosMaterial"
                                       FontSize="21"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#5C4BDD, Dark=#D1CAFF}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding NombreVisible}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#17172C, Dark=White}" />
                                <Label Text="{Binding Detalle}"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#626479, Dark=#B9B9D0}" />
                                <Label Text="{Binding Sugerencia}"
                                       FontAttributes="Bold"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light=#5D4EDD, Dark=#C5BBFF}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="10">
            <Button x:Name="BotonMostrarOtros"
                    Text="Mostrar otros calendarios"
                    Clicked="OnMostrarOtrosClicked"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#5B4BE7, Dark=#C5B9FF}"
                    FontSize="13"
                    HeightRequest="40"
                    IsVisible="False" />
            <Label x:Name="TextoSeleccion"
                   Text="Selecciona una opción para continuar."
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#626479, Dark=#B9B9D0}" />
            <Button x:Name="BotonConfirmar"
                    Text="Guardar entrega aquí"
                    Clicked="OnConfirmarClicked"
                    IsEnabled="False"
                    BackgroundColor="#5A48E5"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
