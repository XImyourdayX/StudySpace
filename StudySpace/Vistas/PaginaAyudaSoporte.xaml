<?xml version='1.0' encoding='UTF-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="StudySpace.Vistas.PaginaAyudaSoporte" Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light=#F8F7FC, Dark=#111427}">

    <Grid Padding="14,12,14,12" RowDefinitions="Auto,*" RowSpacing="14" MaximumWidthRequest="460">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Button Text="‹" FontSize="27" WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#6530B7, Dark=#C6A0FF}" Clicked="OnVolverClicked" SemanticProperties.Description="Regresar al perfil"/>
            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                <Label Text="Ayuda y soporte" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>
                <Label Text="Resuelve dudas y comparte tus comentarios" FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#625C78, Dark=#B9B6D0}"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" Padding="0,0,0,24">
                <Border Padding="14" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#EDE4FB, Dark=#2B2345}" Stroke="{AppThemeBinding Light=#D9D0ED, Dark=#514568}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="7">
                        <Label Text="Estamos mejorando Study Space" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>
                        <Label Text="Si encuentras un problema o tienes una idea, prepara un correo dirigido al soporte de Study Space. Podrás revisarlo antes de enviarlo." FontSize="13" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Preguntas frecuentes" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>

                <Border Padding="14" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1E35}" Stroke="{AppThemeBinding Light=#D9D0ED, Dark=#514568}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="¿Dónde están mis cursos y tareas?" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>
                        <Label Text="Se guardan en este teléfono y están asociados a tu cuenta local. Iniciar sesión en otro dispositivo no las recupera automáticamente." FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#625C78, Dark=#B9B6D0}"/>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#D9D0ED, Dark=#514568}"/>
                        <Label Text="¿Cómo recupero mis datos?" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>
                        <Label Text="Desde Perfil, abre Copias de seguridad y restaura un archivo .ssbackup con la contraseña que elegiste." FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#625C78, Dark=#B9B6D0}"/>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#D9D0ED, Dark=#514568}"/>
                        <Label Text="¿Qué pasa si no recibo un recordatorio?" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>
                        <Label Text="Revisa los permisos de notificación, la anticipación y los horarios configurados. El ahorro de batería de Android también puede retrasar avisos." FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#625C78, Dark=#B9B6D0}"/>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#D9D0ED, Dark=#514568}"/>
                        <Label Text="¿Mis entregas se sincronizan con Google Calendar?" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>
                        <Label Text="Study Space puede añadir eventos al calendario Phone de Android si activas esa opción en Perfil. Que aparezcan en Google depende de la configuración de sincronización del dispositivo." FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#625C78, Dark=#B9B6D0}"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Reportar un problema o sugerencia" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>

                <Border Padding="14" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1E35}" Stroke="{AppThemeBinding Light=#D9D0ED, Dark=#514568}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="15"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Tipo de comentario" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>
                        <Picker x:Name="TipoPicker" Title="Selecciona una opción" SelectedIndex="0" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}">
                            <Picker.Items>
                                <x:String>Reportar un problema</x:String>
                                <x:String>Enviar una sugerencia</x:String>
                                <x:String>Hacer una consulta</x:String>
                            </Picker.Items>
                        </Picker>
                        <Label Text="Cuéntanos qué ocurrió o qué mejorarías" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>
                        <Border Padding="12" StrokeThickness="1" Stroke="{AppThemeBinding Light=#D9D0ED, Dark=#514568}" BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Editor x:Name="DescripcionEditor" Placeholder="Describe los pasos, el resultado esperado y lo que sucedió..." AutoSize="TextChanges" HeightRequest="128" MaxLength="1500" TextColor="{AppThemeBinding Light=#201B36, Dark=#F5F1FF}"/>
                        </Border>
                        <Label Text="No escribas contraseñas, códigos de verificación ni información privada. El reporte solo incluirá lo que tú redactes y la versión de la app." FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#625C78, Dark=#B9B6D0}"/>
                        <Label x:Name="EstadoLabel" IsVisible="False" FontSize="12" LineBreakMode="WordWrap" TextColor="{StaticResource Rojo}"/>
                        <Label Text="Correo de soporte: studyspace.soporte@wopres.com" FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#625C78, Dark=#B9B6D0}"/>
                        <Button x:Name="EnviarCorreoButton" Text="Enviar por correo" HeightRequest="52" CornerRadius="13" FontAttributes="Bold" TextColor="White" Clicked="OnEnviarCorreoClicked"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A34DEB" Offset="0"/><GradientStop Color="#7132D9" Offset="1"/></LinearGradientBrush></Button.Background></Button>
                        <Button Text="Copiar comentario" HeightRequest="46" CornerRadius="12" BackgroundColor="Transparent" BorderColor="{AppThemeBinding Light=#6530B7, Dark=#C6A0FF}" BorderWidth="1" TextColor="{AppThemeBinding Light=#6530B7, Dark=#C6A0FF}" Clicked="OnCopiarClicked"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Al pulsar Enviar por correo se abrirá tu aplicación de correo. Revisa el destinatario y pulsa Enviar allí. Abrir el correo no confirma que el mensaje se haya enviado." FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#625C78, Dark=#B9B6D0}"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
