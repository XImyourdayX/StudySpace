<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StudySpace.VistaModelos"
    x:Class="StudySpace.Vistas.PaginaInicioSesion"
    x:DataType="vm:InicioSesionVM"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,60,24,24"
            Spacing="14"
            MaximumWidthRequest="420"
            HorizontalOptions="Fill">

            <!-- VOLVER -->
            <Label
                FontFamily="IconosMaterial"
                Text="&#xe5c4;"
                FontSize="28"
                TextColor="{AppThemeBinding
                    Light=#141B35,
                    Dark=White}"
                HorizontalOptions="Start">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding VolverCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- LOGO -->
            <Image
                Source="logo.png"
                HeightRequest="90"
                HorizontalOptions="Center" />

            <!-- TÍTULOS -->
            <Label
                Text="¡Bienvenida de nuevo!"
                Style="{StaticResource Titulo}"
                HorizontalOptions="Center"
                Margin="0,10,0,0" />

            <Label
                Text="Ingresa a tu cuenta para continuar"
                Style="{StaticResource Subtitulo}"
                HorizontalOptions="Center"
                Margin="0,0,0,20" />

            <!-- CORREO -->
            <Border
                Style="{StaticResource CampoBorde}"
                Margin="0,6,0,0">

                <Entry
                    Style="{StaticResource EntradaLimpia}"
                    Placeholder="Correo electrónico"
                    Keyboard="Email"
                    Text="{Binding Correo}" />
            </Border>

            <!-- CONTRASEÑA -->
            <Border Style="{StaticResource CampoBorde}">

                <Grid ColumnDefinitions="*,Auto">

                    <Entry
                        x:Name="PasswordEntry"
                        Style="{StaticResource EntradaLimpia}"
                        Placeholder="Contraseña"
                        IsPassword="True"
                        Text="{Binding Password}" />

                    <!-- MOSTRAR / OCULTAR CONTRASEÑA -->
                    <ImageButton
                        x:Name="TogglePasswordButton"
                        Grid.Column="1"
                        Clicked="OnTogglePasswordClicked"
                        BackgroundColor="Transparent"
                        Margin="8,0,0,0"
                        Padding="6"
                        WidthRequest="36"
                        HeightRequest="36"
                        HorizontalOptions="End"
                        VerticalOptions="Center">

                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="IconosMaterial"
                                Glyph="&#xe8f4;"
                                Size="20"
                                Color="{AppThemeBinding
                                    Light={StaticResource TextoSecundarioClaro},
                                    Dark={StaticResource TextoSecundarioOscuro}}" />
                        </ImageButton.Source>
                    </ImageButton>

                </Grid>
            </Border>

            <!-- RECUPERACIÓN DE CONTRASEÑA -->
            <Label
                Text="¿Olvidaste tu contraseña?"
                FontSize="13"
                FontAttributes="Bold"
                HorizontalOptions="End"
                HorizontalTextAlignment="End"
                Margin="0,0,0,2"
                TextColor="{StaticResource Violeta}">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding RecuperarPasswordCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- MENSAJE DE ERROR -->
            <Label
                Text="{Binding MensajeError}"
                IsVisible="{Binding TieneError}"
                TextColor="{StaticResource Rojo}"
                FontSize="13" />

            <!-- INICIAR SESIÓN -->
            <Frame
                HasShadow="True"
                CornerRadius="28"
                Padding="0"
                BackgroundColor="{AppThemeBinding
                    Light={StaticResource Violeta},
                    Dark={StaticResource PrimaryDark}}"
                HorizontalOptions="Fill"
                HeightRequest="56"
                Margin="0,12,0,0">

                <Button
                    Text="Iniciar sesión"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    Command="{Binding IniciarSesionCommand}" />
            </Frame>

            <!-- CARGANDO -->
            <ActivityIndicator
                IsRunning="{Binding Ocupado}"
                Color="{StaticResource Azul}" />

            <!-- IR A REGISTRO -->
            <Label
                Style="{StaticResource Subtitulo}"
                HorizontalOptions="Center"
                Margin="0,20,0,0">

                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="¿No tienes cuenta? " />
                        <Span
                            Text="Regístrate"
                            TextColor="{StaticResource Azul}"
                            FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding IrARegistroCommand}" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
