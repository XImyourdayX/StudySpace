<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StudySpace.VistaModelos"
    x:Class="StudySpace.Vistas.PaginaPerfil"
    x:DataType="vm:PerfilVM"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="22"
          Padding="20,28,20,20"
          MaximumWidthRequest="420"
          HorizontalOptions="Fill">

        <!-- ENCABEZADO -->
        <Label Grid.Row="0"
               Text="Mi perfil"
               FontSize="23"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding
                   Light={StaticResource TextoClaro},
                   Dark={StaticResource TextoOscuro}}" />

        <!-- CONTENIDO DESPLAZABLE -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Spacing="0">

                <!-- INFORMACIÓN DEL USUARIO -->
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="16"
                      Padding="4,18,4,24">

                    <Border WidthRequest="64"
                            HeightRequest="64"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding
                                Light={StaticResource LavandaClaro},
                                Dark={StaticResource LavandaOscuro}}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="32" />
                        </Border.StrokeShape>

                        <Label Text="&#xe7fd;"
                               FontFamily="IconosMaterial"
                               FontSize="33"
                               TextColor="{AppThemeBinding
                                   Light={StaticResource Violeta},
                                   Dark=#AFA4FF}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="6"
                                         VerticalOptions="Center">

                        <Label Text="{Binding Nombre}"
                               FontSize="17"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding
                                   Light={StaticResource TextoClaro},
                                   Dark={StaticResource TextoOscuro}}" />

                        <Label Text="{Binding Correo}"
                               FontSize="12"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding
                                   Light={StaticResource TextoSecundarioClaro},
                                   Dark={StaticResource TextoSecundarioOscuro}}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- SEPARACIÓN DEL PERFIL -->
                <BoxView HeightRequest="1"
                         Margin="0,0,0,18"
                         Color="{AppThemeBinding
                             Light={StaticResource BordeClaro},
                             Dark={StaticResource BordeOscuro}}" />

                <!-- NOTIFICACIONES: MOSTRAR ESTADO GUARDADO -->
                <Grid ColumnDefinitions="34,*,Auto"
                      ColumnSpacing="12"
                      Padding="10,0"
                      HeightRequest="78">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NotificacionesCommand}" />
                    </Grid.GestureRecognizers>

                    <Label Text="&#xe7f4;"
                           FontFamily="IconosMaterial"
                           FontSize="23"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding
                               Light={StaticResource TextoSecundarioClaro},
                               Dark={StaticResource TextoSecundarioOscuro}}" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="5"
                                         VerticalOptions="Center">
                        <Label Text="Notificaciones"
                               FontSize="15"
                               TextColor="{AppThemeBinding
                                   Light={StaticResource TextoClaro},
                                   Dark={StaticResource TextoOscuro}}" />

                        <Label Text="Activadas"
                               FontSize="12"
                               TextColor="{AppThemeBinding
                                   Light={StaticResource TextoSecundarioClaro},
                                   Dark={StaticResource TextoSecundarioOscuro}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding NotificacionesActivas}"
                                             Value="False">
                                    <Setter Property="Text" Value="Desactivadas" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="&#xe5cc;"
                           FontFamily="IconosMaterial"
                           FontSize="23"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding
                               Light={StaticResource TextoSecundarioClaro},
                               Dark={StaticResource TextoSecundarioOscuro}}" />
                </Grid>

                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding
                             Light={StaticResource BordeClaro},
                             Dark={StaticResource BordeOscuro}}" />

                <!-- RECORDATORIOS: MOSTRAR ANTICIPACIÓN Y HORARIO GUARDADOS -->
                <Grid ColumnDefinitions="34,*,Auto"
                      ColumnSpacing="12"
                      Padding="10,0"
                      HeightRequest="98">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding RecordatoriosCommand}" />
                    </Grid.GestureRecognizers>

                    <Label Text="&#xe878;"
                           FontFamily="IconosMaterial"
                           FontSize="23"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding
                               Light={StaticResource TextoSecundarioClaro},
                               Dark={StaticResource TextoSecundarioOscuro}}" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="4"
                                         VerticalOptions="Center">
                        <Label Text="Recordatorios"
                               FontSize="15"
                               TextColor="{AppThemeBinding
                                   Light={StaticResource TextoClaro},
                                   Dark={StaticResource TextoOscuro}}" />

                        <!-- El valor visible responde al guardado en Preferences -->
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="Anticipación:"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding
                                       Light={StaticResource TextoSecundarioClaro},
                                       Dark={StaticResource TextoSecundarioOscuro}}" />
                            <Label Text="1 día antes"
                                   FontSize="12"
                                   TextColor="{StaticResource Violeta}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding MinutosAnticipacion}"
                                                 Value="15">
                                        <Setter Property="Text" Value="15 minutos antes" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding MinutosAnticipacion}"
                                                 Value="60">
                                        <Setter Property="Text" Value="1 hora antes" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding MinutosAnticipacion}"
                                                 Value="1440">
                                        <Setter Property="Text" Value="1 día antes" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding MinutosAnticipacion}"
                                                 Value="2880">
                                        <Setter Property="Text" Value="2 días antes" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="4">
                            <Label Text="Horario:"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding
                                       Light={StaticResource TextoSecundarioClaro},
                                       Dark={StaticResource TextoSecundarioOscuro}}" />
                            <Label Text="{Binding HoraInicio, StringFormat='{0:00}:00'}"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding
                                       Light={StaticResource TextoSecundarioClaro},
                                       Dark={StaticResource TextoSecundarioOscuro}}" />
                            <Label Text="–"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding
                                       Light={StaticResource TextoSecundarioClaro},
                                       Dark={StaticResource TextoSecundarioOscuro}}" />
                            <Label Text="{Binding HoraFin, StringFormat='{0:00}:00'}"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding
                                       Light={StaticResource TextoSecundarioClaro},
                                       Dark={StaticResource TextoSecundarioOscuro}}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="&#xe5cc;"
                           FontFamily="IconosMaterial"
                           FontSize="23"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding
                               Light={StaticResource TextoSecundarioClaro},
                               Dark={StaticResource TextoSecundarioOscuro}}" />
                </Grid>

                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding
                             Light={StaticResource BordeClaro},
                             Dark={StaticResource BordeOscuro}}" />

                <!-- HU15 - CALENDARIO EXTERNO, OPTATIVO Y SIN SELECTOR -->
                <Grid ColumnDefinitions="34,*,Auto"
                      ColumnSpacing="12"
                      Padding="10,0"
                      HeightRequest="96">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding ConfigurarCalendarioExternoCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="&#xe935;"
                           FontFamily="IconosMaterial"
                           FontSize="23"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}" />
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center" Spacing="5">
                        <Label Text="Calendario del teléfono"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}" />
                        <Label Text="Sincronización desactivada"
                               FontSize="12"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding CalendarioExternoActivo}"
                                             Value="True">
                                    <Setter Property="Text" Value="Sincronización automática activada" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                    <Label Grid.Column="2"
                           Text="&#xe5cc;"
                           FontFamily="IconosMaterial"
                           FontSize="23"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}" />
                </Grid>
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource BordeClaro}, Dark={StaticResource BordeOscuro}}" />

                <!-- TEMA DE LA APLICACIÓN -->
                <Grid ColumnDefinitions="34,*,Auto,Auto"
                      ColumnSpacing="10"
                      Padding="10,0"
                      HeightRequest="72">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding CambiarTemaCommand}" />
                    </Grid.GestureRecognizers>

                    <Label Text="&#xe3a9;"
                           FontFamily="IconosMaterial"
                           FontSize="23"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding
                               Light={StaticResource TextoSecundarioClaro},
                               Dark={StaticResource TextoSecundarioOscuro}}" />

                    <Label Grid.Column="1"
                           Text="Tema de la aplicación"
                           FontSize="14"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding
                               Light={StaticResource TextoClaro},
                               Dark={StaticResource TextoOscuro}}" />

                    <Label Grid.Column="2"
                           Text="{Binding TemaActual}"
                           FontSize="12"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding
                               Light={StaticResource TextoSecundarioClaro},
                               Dark={StaticResource TextoSecundarioOscuro}}" />

                    <Label Grid.Column="3"
                           Text="&#xe5cc;"
                           FontFamily="IconosMaterial"
                           FontSize="23"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding
                               Light={StaticResource TextoSecundarioClaro},
                               Dark={StaticResource TextoSecundarioOscuro}}" />
                </Grid>

                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding
                             Light={StaticResource BordeClaro},
                             Dark={StaticResource BordeOscuro}}" />

                <!-- AYUDA Y SOPORTE -->
                <Grid ColumnDefinitions="34,*,Auto"
                      ColumnSpacing="12"
                      Padding="10,0"
                      HeightRequest="72">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding AyudaCommand}" />
                    </Grid.GestureRecognizers>

                    <Label Text="&#xe887;"
                           FontFamily="IconosMaterial"
                           FontSize="23"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding
                               Light={StaticResource TextoSecundarioClaro},
                               Dark={StaticResource TextoSecundarioOscuro}}" />

                    <Label Grid.Column="1"
                           Text="Ayuda y soporte"
                           FontSize="15"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding
                               Light={StaticResource TextoClaro},
                               Dark={StaticResource TextoOscuro}}" />

                    <Label Grid.Column="2"
                           Text="&#xe5cc;"
                           FontFamily="IconosMaterial"
                           FontSize="23"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding
                               Light={StaticResource TextoSecundarioClaro},
                               Dark={StaticResource TextoSecundarioOscuro}}" />
                </Grid>

                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding
                             Light={StaticResource BordeClaro},
                             Dark={StaticResource BordeOscuro}}" />

                <!-- CERRAR SESIÓN -->
                <Grid ColumnDefinitions="34,*"
                      ColumnSpacing="12"
                      Padding="10,0"
                      HeightRequest="76"
                      Margin="0,16,0,0">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding CerrarSesionCommand}" />
                    </Grid.GestureRecognizers>

                    <Label Text="&#xe9ba;"
                           FontFamily="IconosMaterial"
                           FontSize="23"
                           VerticalOptions="Center"
                           TextColor="{StaticResource Rojo}" />

                    <Label Grid.Column="1"
                           Text="Cerrar sesión"
                           FontSize="15"
                           VerticalOptions="Center"
                           TextColor="{StaticResource Rojo}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
