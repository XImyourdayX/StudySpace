<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StudySpace.VistaModelos"
    x:Class="StudySpace.Vistas.PaginaRegistro"
    x:DataType="vm:RegistroVM"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,40,24,32"
            Spacing="14"
            MaximumWidthRequest="420"
            HorizontalOptions="Fill">

            <!-- VOLVER -->
            <Label
                FontFamily="IconosMaterial"
                Text="&#xe5c4;"
                FontSize="28"
                TextColor="{AppThemeBinding Light=#141B35, Dark=White}"
                HorizontalOptions="Start">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding VolverCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- IDENTIDAD DE STUDY SPACE -->
            <Image
                Source="logo.png"
                HeightRequest="72"
                HorizontalOptions="Center"
                Margin="0,4,0,0" />

            <Label
                Text="Crear cuenta"
                Style="{StaticResource Titulo}"
                HorizontalTextAlignment="Center"
                Margin="0,4,0,0" />

            <Label
                Text="Organiza tus cursos, tareas y recordatorios en un solo lugar."
                Style="{StaticResource Subtitulo}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,16" />

            <!-- NOMBRE COMPLETO -->
            <Border
                Style="{StaticResource CampoBorde}">
                <Entry
                    Style="{StaticResource EntradaLimpia}"
                    Placeholder="Nombre completo"
                    Text="{Binding Nombre}"
                    ReturnType="Next" />
            </Border>

            <!-- CORREO ELECTRONICO -->
            <Border Style="{StaticResource CampoBorde}">
                <Entry
                    Style="{StaticResource EntradaLimpia}"
                    Placeholder="Correo electrónico"
                    Keyboard="Email"
                    Text="{Binding Correo}"
                    ReturnType="Next" />
            </Border>

            <!-- CONTRASENA -->
            <Border Style="{StaticResource CampoBorde}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry
                        x:Name="PasswordEntry"
                        Style="{StaticResource EntradaLimpia}"
                        Placeholder="Contraseña (mínimo 8 caracteres)"
                        IsPassword="True"
                        Text="{Binding Password}"
                        ReturnType="Next" />

                    <ImageButton
                        x:Name="TogglePasswordButton"
                        Grid.Column="1"
                        Clicked="OnTogglePasswordClicked"
                        BackgroundColor="Transparent"
                        Margin="8,0,0,0"
                        Padding="6"
                        WidthRequest="36"
                        HeightRequest="36"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="IconosMaterial"
                                Glyph="&#xe8f4;"
                                Size="20"
                                Color="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}" />
                        </ImageButton.Source>
                    </ImageButton>
                </Grid>
            </Border>

            <!-- CONFIRMAR CONTRASENA -->
            <Border Style="{StaticResource CampoBorde}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry
                        x:Name="ConfirmEntry"
                        Style="{StaticResource EntradaLimpia}"
                        Placeholder="Confirmar contraseña"
                        IsPassword="True"
                        Text="{Binding Confirmar}"
                        ReturnType="Done" />

                    <ImageButton
                        x:Name="ToggleConfirmButton"
                        Grid.Column="1"
                        Clicked="OnToggleConfirmClicked"
                        BackgroundColor="Transparent"
                        Margin="8,0,0,0"
                        Padding="6"
                        WidthRequest="36"
                        HeightRequest="36"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                        <ImageButton.Source>
                            <FontImageSource
                                FontFamily="IconosMaterial"
                                Glyph="&#xe8f4;"
                                Size="20"
                                Color="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}" />
                        </ImageButton.Source>
                    </ImageButton>
                </Grid>
            </Border>

            <!-- MENSAJES DE VALIDACION -->
            <Label
                Text="{Binding MensajeError}"
                IsVisible="{Binding TieneError}"
                TextColor="{StaticResource Rojo}"
                FontSize="13" />

            <!-- ACCION PRINCIPAL -->
            <Frame
                HasShadow="True"
                CornerRadius="28"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Violeta}, Dark={StaticResource PrimaryDark}}"
                HorizontalOptions="Fill"
                HeightRequest="56"
                Margin="0,10,0,0">
                <Button
                    Text="Crear cuenta"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    Command="{Binding CrearCuentaCommand}" />
            </Frame>

            <!-- INDICADOR DE CARGA -->
            <ActivityIndicator
                IsRunning="{Binding Ocupado}"
                IsVisible="{Binding Ocupado}"
                Color="{StaticResource Azul}"
                HorizontalOptions="Center" />

            <!-- EXPLICACION DEL SIGUIENTE PASO -->
            <Label
                Text="Te enviaremos un código por correo para activar tu cuenta."
                Style="{StaticResource Subtitulo}"
                FontSize="12"
                HorizontalTextAlignment="Center"
                Margin="0,2,0,0" />

            <!-- IR A INICIO DE SESION -->
            <Label
                Style="{StaticResource Subtitulo}"
                HorizontalOptions="Center"
                Margin="0,12,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="¿Ya tienes cuenta? " />
                        <Span
                            Text="Inicia sesión"
                            TextColor="{StaticResource Azul}"
                            FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding IrAInicioSesionCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
