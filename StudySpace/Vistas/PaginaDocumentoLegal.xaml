<?xml version='1.0' encoding='UTF-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="StudySpace.Vistas.PaginaDocumentoLegal" Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark=#101326}">
    <Grid RowDefinitions="Auto,*" Padding="14,10,14,0" RowSpacing="10" MaximumWidthRequest="520" HorizontalOptions="Fill">
        <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
            <Button Text="" FontFamily="IconosMaterial" FontSize="22" WidthRequest="44" HeightRequest="44" Padding="0" CornerRadius="14" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light={StaticResource LavandaClaro}, Dark=#32234F}" TextColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark=#D7B8FF}" Clicked="OnVolverClicked" SemanticProperties.Description="Regresar a privacidad"/>
            <Label Grid.Column="1" Text="Study Space  /  Información legal" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark=#C4B8DD}"/>
        </Grid>
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Spacing="14" Padding="0,0,0,22">
                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark=#65508E}" Padding="14" StrokeShape="RoundRectangle 18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{AppThemeBinding Light={StaticResource TarjetaClaro}, Dark=#282044}" Offset="0"/>
                            <GradientStop Color="{AppThemeBinding Light={StaticResource TarjetaClaro}, Dark=#171A31}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource LavandaClaro}, Dark=#49316F}" VerticalOptions="Center">
                                <Label x:Name="IconoDocumento" Text="" FontFamily="IconosMaterial" FontSize="23" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark=#E1C5FF}"/>
                            </Border>
                            <Label Grid.Column="1" x:Name="TituloDocumento" Text="Información legal" FontSize="21" FontAttributes="Bold" LineBreakMode="WordWrap" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark=#F5F1FF}"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource BordeClaro}, Dark=#55446F}"/>
                        <Label Text="Study Space · Versión preliminar" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark=#C4B8DD}"/>
                        <Label Text="20 de noviembre de 2026" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark=#C4B8DD}"/>
                    </VerticalStackLayout>
                </Border>
                <Border Padding="14,4" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark=#393450}" StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light={StaticResource TarjetaClaro}, Dark=#171A30}">
                    <VerticalStackLayout x:Name="SeccionesDocumento" Spacing="0"/>
                </Border>
                <Label Text="Versión de trabajo · 20 de noviembre de 2026 · Requiere validación previa al piloto" FontSize="11" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark=#C4B8DD}"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>