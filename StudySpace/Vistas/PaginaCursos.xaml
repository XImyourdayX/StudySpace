<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StudySpace.VistaModelos"
    xmlns:dto="clr-namespace:Aplicacion.DTOs;assembly=Aplicacion"
    x:Class="StudySpace.Vistas.PaginaCursos"
    x:DataType="vm:CursosVM"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="16"
          Padding="20,30,20,12"
          MaximumWidthRequest="420"
          HorizontalOptions="Fill">

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">

            <Label Text="Mis cursos"
                   FontSize="21"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding
                       Light={StaticResource TextoClaro},
                       Dark={StaticResource TextoOscuro}}" />

            <!-- AGREGAR CURSO -->
            <Border Grid.Column="1"
                    WidthRequest="42"
                    HeightRequest="42"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource Violeta}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Label Text="&#xe145;"
                       FontFamily="IconosMaterial"
                       FontSize="25"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding AgregarCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- FILTROS -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="7">

            <!-- TODOS -->
            <Border Grid.Column="0"
                    Padding="8,11"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding
                        Light={StaticResource LavandaClaro},
                        Dark={StaticResource LavandaOscuro}}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding FiltroTodosActivo}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource Violeta}" />
                    </DataTrigger>
                </Border.Triggers>

                <Label Text="Todos"
                       FontSize="12"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding
                           Light={StaticResource TextoSecundarioClaro},
                           Dark={StaticResource TextoSecundarioOscuro}}">

                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding FiltroTodosActivo}"
                                     Value="True">
                            <Setter Property="TextColor"
                                    Value="White" />
                            <Setter Property="FontAttributes"
                                    Value="Bold" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding MostrarTodosCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <!-- ACTUALES -->
            <Border Grid.Column="1"
                    Padding="8,11"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding
                        Light={StaticResource LavandaClaro},
                        Dark={StaticResource LavandaOscuro}}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding FiltroActualesActivo}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource Violeta}" />
                    </DataTrigger>
                </Border.Triggers>

                <Label Text="Actuales"
                       FontSize="12"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding
                           Light={StaticResource TextoSecundarioClaro},
                           Dark={StaticResource TextoSecundarioOscuro}}">

                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding FiltroActualesActivo}"
                                     Value="True">
                            <Setter Property="TextColor"
                                    Value="White" />
                            <Setter Property="FontAttributes"
                                    Value="Bold" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding MostrarActualesCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <!-- FINALIZADOS -->
            <Border Grid.Column="2"
                    Padding="8,11"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding
                        Light={StaticResource LavandaClaro},
                        Dark={StaticResource LavandaOscuro}}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding FiltroFinalizadosActivo}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource Violeta}" />
                    </DataTrigger>
                </Border.Triggers>

                <Label Text="Finalizados"
                       FontSize="12"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding
                           Light={StaticResource TextoSecundarioClaro},
                           Dark={StaticResource TextoSecundarioOscuro}}">

                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding FiltroFinalizadosActivo}"
                                     Value="True">
                            <Setter Property="TextColor"
                                    Value="White" />
                            <Setter Property="FontAttributes"
                                    Value="Bold" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding MostrarFinalizadosCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- LISTA DE CURSOS -->
        <Grid Grid.Row="2">

            <CollectionView ItemsSource="{Binding Cursos}"
                            VerticalOptions="Fill">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:CursoDTO">

                        <!-- TARJETA SELECCIONABLE -->
                        <Border StrokeThickness="1"
                                Stroke="{Binding Color}"
                                Padding="13"
                                BackgroundColor="{AppThemeBinding
                                    Light={StaticResource TarjetaClaro},
                                    Dark={StaticResource TarjetaOscuro}}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <!-- ABRIR DETALLE DEL CURSO -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnCursoTapped" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12"
                                  MinimumHeightRequest="54">

                                <!-- ICONO DEL CURSO -->
                                <Border Grid.Column="0"
                                        WidthRequest="46"
                                        HeightRequest="46"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        BackgroundColor="{Binding Color}">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Label Text="&#xea19;"
                                           FontFamily="IconosMaterial"
                                           FontSize="24"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- INFORMACIÓN DEL CURSO -->
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="5">

                                    <Label Text="{Binding Nombre}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding
                                               Light={StaticResource TextoClaro},
                                               Dark={StaticResource TextoOscuro}}" />

                                    <Label Text="{Binding TextoPendientes}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding
                                               Light={StaticResource TextoSecundarioClaro},
                                               Dark={StaticResource TextoSecundarioOscuro}}" />

                                </VerticalStackLayout>

                                <!-- FLECHA -->
                                <Label Grid.Column="2"
                                       Text="&#xe5cc;"
                                       FontFamily="IconosMaterial"
                                       FontSize="23"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding
                                           Light={StaticResource TextoSecundarioClaro},
                                           Dark={StaticResource TextoSecundarioOscuro}}" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- MENSAJE VACÍO -->
            <Label Text="No hay cursos en esta categoría."
                   IsVisible="{Binding EstaVacio}"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Start"
                   Margin="10,40,10,0"
                   FontSize="13"
                   TextColor="{AppThemeBinding
                       Light={StaticResource TextoSecundarioClaro},
                       Dark={StaticResource TextoSecundarioOscuro}}" />

        </Grid>

        <!-- BOTÓN INFERIOR -->
        <Button Grid.Row="3"
                Text="+ Nueva tarea"
                HeightRequest="52"
                Margin="0,5,0,0"
                Style="{StaticResource BotonPrincipal}"
                BackgroundColor="{StaticResource Violeta}"
                Command="{Binding NuevaTareaCommand}" />

    </Grid>
</ContentPage>
