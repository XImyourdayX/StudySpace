<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudySpace.VistaModelos"
             xmlns:dto="clr-namespace:Aplicacion.DTOs;assembly=Aplicacion"
             x:Class="StudySpace.Vistas.PaginaCursos"
             x:DataType="vm:CursosVM"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,40,24,24"
          MaximumWidthRequest="420" HorizontalOptions="Fill">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <Label Text="Mis cursos" Style="{StaticResource Titulo}" VerticalOptions="Center" />
            <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                    StrokeThickness="0" BackgroundColor="{StaticResource Azul}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Label FontFamily="IconosMaterial" Text="&#xe145;" FontSize="26"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AgregarCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Cursos}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:CursoDTO">
                    <Border Style="{StaticResource Tarjeta}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0"
                                    BackgroundColor="{Binding Color}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label FontFamily="IconosMaterial" Text="&#xea19;" FontSize="24"
                                       TextColor="White" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Nombre}" Style="{StaticResource Etiqueta}" FontSize="15" />
                                <Label Text="{Binding TextoPendientes}" Style="{StaticResource Subtitulo}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1" Text="Aún no tienes cursos. Toca + para agregar el primero."
               Style="{StaticResource Subtitulo}" HorizontalTextAlignment="Center"
               VerticalOptions="Start" Margin="0,40,0,0"
               IsVisible="{Binding EstaVacio}" />

        <Button Grid.Row="2" Text="Nueva tarea" Style="{StaticResource BotonPrincipal}"
                Command="{Binding NuevaTareaCommand}" Margin="0,12,0,0" />
    </Grid>
</ContentPage>