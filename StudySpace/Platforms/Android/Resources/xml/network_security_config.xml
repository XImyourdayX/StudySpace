<?xml version="1.0" encoding="utf-8"?>

<network-security-config>

	<!--
        Mantener HTTPS obligatorio.
        No permitir conexiones HTTP sin cifrar.
    -->
	<base-config cleartextTrafficPermitted="false">
		<trust-anchors>
			<certificates src="system" />
		</trust-anchors>
	</base-config>

	<!--
        Certificado de Study Space.
        Solo se acepta cuando Android ejecuta
        una versión de depuración de la aplicación.
    -->
	<debug-overrides>
		<trust-anchors>
			<certificates src="@raw/studyspace_ca" />
		</trust-anchors>
	</debug-overrides>

</network-security-config>
