<?xml version='1.0' encoding='UTF-8'?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#304BFF</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Marca (iguales en claro y oscuro) -->
    <Color x:Key="Azul">#304BFF</Color>
    <Color x:Key="Violeta">#5544E9</Color>
    <Color x:Key="Verde">#22B981</Color>
    <Color x:Key="Ambar">#F59E0B</Color>
    <Color x:Key="Rojo">#EF4444</Color>

    <!-- Tema claro -->
    <Color x:Key="FondoClaro">#F6F7FB</Color>
    <Color x:Key="TarjetaClaro">#FFFFFF</Color>
    <Color x:Key="LavandaClaro">#EDE8F7</Color>
    <Color x:Key="TextoClaro">#192136</Color>
    <Color x:Key="TextoSecundarioClaro">#626B80</Color>
    <Color x:Key="BordeClaro">#DCE0E9</Color>

    <!-- Tema oscuro -->
    <Color x:Key="FondoOscuro">#111427</Color>
    <Color x:Key="TarjetaOscuro">#1C2038</Color>
    <Color x:Key="LavandaOscuro">#382951</Color>
    <Color x:Key="TextoOscuro">#F5F3FF</Color>
    <Color x:Key="TextoSecundarioOscuro">#ADB2C8</Color>
    <Color x:Key="BordeOscuro">#51436E</Color>
    <!-- Recursos semánticos para ambos temas -->
    <Color x:Key="AcentoClaro">#6743C1</Color>
    <Color x:Key="AcentoOscuro">#C6A0FF</Color>
    <Color x:Key="AccionClaro">#6743C1</Color>
    <Color x:Key="AccionOscuro">#813DE0</Color>
    <Color x:Key="CampoClaro">#F0F2F7</Color>
    <Color x:Key="CampoOscuro">#252941</Color>
<Color x:Key="AccionFinalClaro">#5935B0</Color>
    <Color x:Key="DecoracionClara">#F1EEF8</Color>
    <Color x:Key="DecoracionTransparenteClara">#00EDE8F7</Color>
    <Color x:Key="BordeAcentoClaro">#D4C8EC</Color>
    <Color x:Key="ExitoTextoClaro">#146C4B</Color>
    <Color x:Key="AvisoTextoClaro">#89530A</Color>
    <Color x:Key="ErrorTextoClaro">#A82845</Color>
    <Color x:Key="ExitoFondoClaro">#E7F5EE</Color>
    <Color x:Key="AvisoFondoClaro">#FFF3DE</Color>
    <Color x:Key="ErrorFondoClaro">#FCECEF</Color>
    <Color x:Key="ExitoBordeClaro">#B8DCCB</Color>
    <Color x:Key="AvisoBordeClaro">#E4C994</Color>
    <Color x:Key="ErrorBordeClaro">#EBC2CD</Color>
    <Color x:Key="PremiumFondoClaro">#FFF9ED</Color>
    <Color x:Key="PremiumBordeClaro">#E5D2A5</Color>
    <Color x:Key="PremiumTextoClaro">#79510C</Color>
</ResourceDictionary>